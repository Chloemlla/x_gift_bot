XPG_ORIGIN=https://xpg.example.com
XPG_LISTEN=127.0.0.1:8788
XPG_DATA_DIR=/var/lib/xpg
XPG_PASSWORD_FILE=/etc/xpg/vault-password

# Optional: when set, /api/check and /api/link require the X-XPG-Key header
# with this file's contents. The page asks for the key on first use.
XPG_PASSCODE_FILE=/etc/xpg/passcode